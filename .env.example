# Copy this file to .env and fill in real values.

# Phase 1 — web search/fetch (free tier, no card required)
# Get a key at https://tavily.com
TAVILY_API_KEY=

# Phase 2 — Gmail + Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN= — filled in automatically after the first OAuth consent run

# v1.1 — iCloud Calendar (CalDAV). ICLOUD_APPLE_ID is the full Apple ID
# email. ICLOUD_APP_PASSWORD is NOT your Apple ID password — generate a
# dedicated app-specific password at https://appleid.apple.com under
# "Sign-In and Security" -> "App-Specific Passwords".
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=

# Phase 3 — wake word (free AccessKey, no card required)
# Get one at https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=
